# Copy to .env (never committed) and fill in your Fi app login. This is the
# same email and password you use in the Fi app on your phone. It drives
# both `kona probe` and the Activity tab in `kona serve`.
FI_EMAIL=
FI_PASSWORD=
# How often the app asks Fi for fresh numbers. Fi's API is undocumented and
# not ours; do not set this low.
KONA_FI_REFRESH_SECONDS=300
# Ignore aggregates from an older or unworn collar before this local date.
# Leave blank if every reading on the Fi pet profile belongs to this setup.
KONA_FI_DATA_START=

# Web app (kona serve). Passcode is shared by everyone who may watch Kona.
KONA_PASSCODE=
# Any long random string; keeps logins valid across restarts. Generate one with:
#   PowerShell:  -join ((48..57)+(97..122) | Get-Random -Count 40 | % {[char]$_})
KONA_SECRET=
# usb (webcam on this machine) | rtsp (network camera, e.g. Tapo TC73) | fake
KONA_CAMERA_SOURCE=usb
# Which model, so the app shows only the controls it really has.
# c120/c110/c100 = fixed. c210/c220/c225 = pan and tilt. Blank = video only.
KONA_CAMERA_MODEL=
# usb: `uv run kona cameras` prints the indexes that open.
KONA_CAMERA_INDEX=0
# rtsp: bare URL, no credentials in it. Tapo: rtsp://<camera-ip>:554/stream1 (HD)
# or /stream2 (SD). User/password = the *camera account* set in the Tapo app
# (Advanced Settings > Camera Account), not your TP-Link login.
KONA_RTSP_URL=
KONA_RTSP_USER=
KONA_RTSP_PASSWORD=
# Seconds without a new frame before the picture is shown as stale / the
# connection is considered hung and reopened.
KONA_STALE_SECONDS=3
KONA_HANG_SECONDS=10
