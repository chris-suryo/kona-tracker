# OS / editor junk (asset zips, esp. Mac-made, drag these in).
__MACOSX/
._*
.DS_Store
Thumbs.db
.env

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
dist/

# Fi probe output: contains account data (redacted, but still private).
probe-out/
# The recorder's database: where Kona actually was, hour by hour, for as long
# as the collar has existed. Never commit it -- this repository is public, and
# a year of a dog's GPS history is a year of her owners' movements.
*.db
*.db-wal
*.db-shm
# The app's log (KONA_LOG_DIR): every request with the address it came from,
# plus camera and robot errors. Point KONA_LOG_DIR outside the repo; this is
# the backstop for when it is not. `.1`-style names are the rotated backups.
*.log
*.log.*
logs/

# Contact sheets for a nitpick round (scripts/contact_sheet.js): generated
# from current-ui/ on demand and sent to a phone, not a record.
docs/screenshots/contact/
