# Treat binary assets as binary so autocrlf never text-corrupts them.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ogg binary
*.wav binary
*.mp3 binary
*.ttf binary
*.otf binary
# Vendored Leaflet must stay byte-for-byte what npm publishes (its css has
# CRLF line endings); the test pins the sha256 that unpkg's SRI carried.
src/kona_tracker/web/static/leaflet/** -text
